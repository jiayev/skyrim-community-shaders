# NvPerf on every graph pass and barrier batch at the newest save. Keep the game focused.
CS_NVPERF_RANGES=cs.dclf.*,cs.llf.*,cs.org.*
CS_NVPERF_METRICS=gpu__time_duration:counter,smsp__inst_executed_shader_cs:counter,smsp__inst_executed_shader_ps:counter,smsp__inst_executed_shader_vs:counter
CS_NVPERF_START_FRAME=1800
CS_NVPERF_SAMPLES=4
CS_DCLF_TEST_EXIT=2800
CS_DCLF_SHADER_DEBUG=0

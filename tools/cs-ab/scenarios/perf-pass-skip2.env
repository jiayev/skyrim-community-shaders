# Live removal of passes at the newest save (CS_PASS_SKIP), blocks of 250 frames. Needs bDisableAutoVanityMode=1 in Skyrim.ini: the idle camera spins from about two minutes. Keep the game focused.
CS_GPU_EVENT_TIMERS=250
CS_PASS_SKIP=Depth|World|Terrain Blending - Blend Prepass Depths|ISCopySubRegionCS Dispatch|ScreenSpaceShadows::RayMarch|Skylighting::ProbeUpdate|ScreenSpaceGI::RadianceDisocc|ScreenSpaceGI::Blur|DeferredComposite|ScreenSpaceGI::GI
CS_DCLF_TEST_EXIT=19000

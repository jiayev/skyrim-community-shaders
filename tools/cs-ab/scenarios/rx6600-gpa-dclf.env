# RX 6600 hardware counters (GPUPerfAPI) at the newest save, as rx6600-perf: 3,000 frames to settle, then a capture of the
# engine's main passes and DCLF's own perf events (on Vulkan DCLF's CPU-driven draws record into DXVK's command buffers,
# so they are inside these). One nesting level: name the passes to compare, not their parents. The graph's own passes
# (cs.dclf*) do not complete yet on the Vulkan backend. Results: "[GpuCounters]" log lines and CommunityShaders-GpuCounters.csv beside the log.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GPA=1
CS_GPU_COUNTERS_RANGES=CS DCLF: main opaque (CPU),CS DCLF: Z-prepass (CPU),CS DCLF: shadow views (CPU)
CS_GPU_COUNTERS_START_FRAME=3200
CS_GPU_COUNTERS_SAMPLES=2
CS_DCLF_TEST_COMMANDS=30:tgm
CS_DCLF_TEST_EXIT=4010

# RX 6600 hardware counters (GPUPerfAPI) of the engine's directional shadow maps alone, as rx6600-gpa: for DXVK with DCLF off,
# whose wider capture lost the device once. Compare with rx6600-gpa-dclf's "CS DCLF: shadow views (CPU)".
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GPA=1
CS_GPU_COUNTERS_RANGES=Directional Light Shadowmaps
CS_GPU_COUNTERS_START_FRAME=3200
CS_GPU_COUNTERS_SAMPLES=2
CS_DCLF_TEST_COMMANDS=30:tgm
CS_DCLF_TEST_EXIT=4010

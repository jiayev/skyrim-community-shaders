# The open crashes' conditions: a long flight over exteriors with cells streaming (24 units a frame, a turn between legs), under
# persistent parity as in the runs that crashed 70-100 s in (a freed child detached, actor teardown). Run it several times.
CS_DCLF_PERSISTENT_PARITY=1
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=950:coc Whiterun;1100:tcl
CS_DCLF_TEST_MOVE=2100:2900:24;3000:3800:24;3900:4700:24;4800:5600:24;5700:6500:24;6600:7400:24;7500:8300:24;8400:9200:24;9300:10100:24;10200:11000:24;11100:11900:24;12000:12800:24;12900:13700:24;13800:14600:24
CS_DCLF_TEST_TURN=2900:3000:1;3800:3900:-1;4700:4800:1;5600:5700:-1;6500:6600:1;7400:7500:-1;8300:8400:1;9200:9300:-1;10100:10200:1;11000:11100:-1;11900:12000:1;12800:12900:-1;13700:13800:1;14600:14700:-1
CS_DCLF_TEST_EXIT=14800

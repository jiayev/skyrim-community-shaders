# Improved Camera in first person looking down at the body (player.setangle x 70), with the late pose on: the head must be
# hidden in the views after the shadows. latepose-ic-look-off.env is the same with it off, where the head shows. The GPU-driven
# graph, then the CPU pipeline.
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=400:player.setangle x 70;600:dclf:shot=lp-look-on-gpu;700:dclf:pipeline=cpu;1000:player.setangle x 70;1100:dclf:shot=lp-look-on-cpu;1200:dclf:pipeline=auto
CS_DCLF_TEST_EXIT=1400

# RX 6600: one view GPU-driven under each cull mode (2 frustum + occlusion, 1 frustum, 0 none), then CPU-driven; shots in
# <log directory>/dclf-shots. tgm first: a wolf attacks the player at the newest save.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=30:tgm;1500:dclf:shot=rx-c2;1510:dclf:cull=frustum;1520:dclf:wait=settled;1600:dclf:shot=rx-c1;1610:dclf:cull=off;1620:dclf:wait=settled;1700:dclf:shot=rx-c0;1710:dclf:cull=occlusion;1720:dclf:pipeline=cpu;1730:dclf:wait=settled;1900:dclf:shot=rx-cpu
CS_DCLF_TEST_EXIT=1950

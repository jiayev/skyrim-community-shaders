# NvPerf per shadow view at the newest save. Keep the game focused.
CS_NVPERF_RANGES=cs.dclf.shadow.view-*,cs.dclf.shadow.occlusion-map
CS_NVPERF_METRICS=gpu__time_duration:counter,pda__input_prims:counter,fe__draw_count:counter,sm__threads_launched_shader_vs:counter,smsp__inst_executed_shader_vs:counter,smsp__inst_executed_shader_ps:counter,raster__zcull_input_samples:counter
CS_NVPERF_START_FRAME=1800
CS_NVPERF_SAMPLES=4
CS_DCLF_TEST_EXIT=2800
CS_DCLF_SHADER_DEBUG=0

# RX 6600 timing at a location named by the caller: pass CS_DCLF_TEST_COMMANDS (tgm, a coc, then marks at 3000 and 4000) and
# CS_DCLF_TEST_EXIT=4010 with -Env. Timer blocks every 250 frames; hang markers on.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GPU_EVENT_TIMERS=250

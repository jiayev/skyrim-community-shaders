# Rebuilds the graph again and again: exterior and interior alternate every 500 frames (each change of cell type rebuilds it;
# interiors take the CPU pipeline). Catches "Previous synchronous admission has not terminated" after a rebuild.
CS_DCLF_TEST_COMMANDS=600:coc WhiterunDragonsreach;1100:coc Whiterun;1600:coc WhiterunDragonsreach;2100:coc Whiterun;2600:coc WhiterunDragonsreach;3100:coc Whiterun;3600:coc WhiterunDragonsreach;4100:coc Whiterun;4600:coc WhiterunDragonsreach;5100:coc Whiterun;5600:coc WhiterunDragonsreach;6100:coc Whiterun;6600:coc WhiterunDragonsreach;7100:coc Whiterun;7600:coc WhiterunDragonsreach;8100:coc Whiterun;8600:coc WhiterunDragonsreach
CS_DCLF_TEST_EXIT=9000

# NvPerf per sky draw at the newest save: what the water cubemap's clouds cost against dev. Keep the game focused.
CS_NVPERF_RANGES=[Sky:*
CS_NVPERF_START_FRAME=900
CS_NVPERF_SAMPLES=4
CS_DCLF_TEST_EXIT=1500
CS_DCLF_SHADER_DEBUG=0
CS_NVPERF_METRICS=gpu__time_duration:counter,sm__warps_launched_shader_ps:counter,sm__threads_launched_shader_ps:counter,smsp__inst_executed_shader_ps:counter,raster__zcull_input_samples:counter,raster__zcull_output_samples:counter,prop__prop2crop_pixels_realtime:counter,pda__input_prims:counter,prop__prop2sm_pixels_mode_earlyz:counter,prop__prop2sm_pixels_mode_latez:counter

# latepose-ic-look.env with the late pose off: Improved Camera's hidden head shows in DCLF's draws.
CS_DCLF_LATE_POSE=0
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=400:player.setangle x 70;600:dclf:shot=lp-look-off-gpu;700:dclf:pipeline=cpu;1000:player.setangle x 70;1100:dclf:shot=lp-look-off-cpu;1200:dclf:pipeline=auto
CS_DCLF_TEST_EXIT=1400

# Vertex-stage faults at load (an Aftermath "Shader Instruction Error" at PC 0 of one 5 KB vertex shader, a few launches in 250):
# two loads, then exit. Run it many times; the shader debug info lets the dump name the shader. Add one Aftermath flag at a time.
DXVK_AFTERMATH_SHADER_DEBUG_INFO=1
CS_DCLF_TEST_COMMANDS=600:coc WhiterunDragonsreach;1100:coc Whiterun
CS_DCLF_TEST_EXIT=1800

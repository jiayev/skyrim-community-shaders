# RX 6600: short set-parity run at the newest save (GPU culling against the CPU's verdicts; "members rejected with their live
# bound in view" counts wrong rejections). tgm first: a wolf attacks the player at the newest save.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_SET_PARITY=1
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=30:tgm
CS_DCLF_TEST_EXIT=1300

# The AMD integrated GPU (D24S8 depth is backed by D32_SFLOAT_S8_UINT there; descriptor buffers, no descriptor heap) under the
# Vulkan validation layer, with FSR (upscaleMethodNoDLSS). Messages go to the file named below. Streamline loads no NVIDIA plugin
# (DLSS, DLSS-G, Reflex): with the RTX 5080 also present, they add NV extensions to the AMD device, which then fails to create.
DXVK_FILTER_DEVICE_NAME=AMD Radeon(TM) Graphics
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
VK_LOADER_LAYERS_ENABLE=*validation
VK_LAYER_DEBUG_ACTION=VK_DBG_LAYER_ACTION_LOG_MSG
VK_LAYER_LOG_FILENAME=C:\Modding\CS-AB\vk-validation.txt
CS_STREAMLINE_DLSS=0
CS_STREAMLINE_REFLEX=0
VK_LAYER_DUPLICATE_MESSAGE_LIMIT=100000
CS_DCLF_TEST_COMMANDS=900:coc WhiterunDragonsreach;1500:coc Whiterun
CS_DCLF_TEST_EXIT=2100

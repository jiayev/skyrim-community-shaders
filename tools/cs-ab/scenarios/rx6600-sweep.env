# RX 6600: a camera sweep at the newest save to provoke device losses (hang markers on). No exit of its own: the sweep driver
# moves the mouse side to side for a set time after tgm, then ends the game. tgm first: a wolf attacks the player at the newest
# save.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=30:tgm

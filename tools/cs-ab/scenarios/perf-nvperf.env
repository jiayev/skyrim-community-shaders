# NvPerf counters at the newest save, with the same ranges and default metrics on every build. Keep the game focused.
# dev writes SKSE\CommunityShaders-NvPerf.csv; the branch also honours CS_NVPERF_CSV.
CS_NVPERF_RANGES=Depth,Directional Light Shadowmaps,Spot Light Shadowmaps,Omnidirectional Light Shadowmaps,Cubemap*,Shadowmasks,World,First Person View,Water Effects,Effects,Volumetric Lighting,LightLimitFix*,Terrain Blending*,Skylighting Mask,Precipitation Mask,SSS*,Upscaling,cs.*,[Post Processing] Pre-Upscale,HDR Processing,Color Grading and Tonemapping,COD Bloom,Depth of Field,Histogram Auto Exposure,Local Exposure,Lens Flare,Physical Glare,RCAS Sharpening,UI Brightness Scale,Render Target Upscaling
CS_NVPERF_START_FRAME=1400
CS_NVPERF_SAMPLES=4
CS_DCLF_TEST_EXIT=2000

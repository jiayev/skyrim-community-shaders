# Improved Camera in first person (its default profile: the body shown, the head hidden after the shadow maps), with DCLF's late pose
# of the player as it ships. The head must be hidden in the shots, its shadow kept. latepose-ic-off.env is the same with the late pose
# off (CS_DCLF_LATE_POSE=0): there the head shows. The GPU-driven graph, then the CPU pipeline.
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=600:dclf:shot=lp-ic-on-gpu;1100:dclf:pipeline=cpu;1500:dclf:shot=lp-ic-on-cpu;1600:dclf:pipeline=auto
CS_DCLF_TEST_EXIT=1900

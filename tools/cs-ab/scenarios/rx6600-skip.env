# RX 6600 live removal at the newest save (CS_PASS_SKIP): each named event's draws and dispatches dropped in turn, 180 frames a
# phase, alternating with none; four rounds, as phases count presents from the process start and the first ones can fall in the
# menu (read only the phases after the tgm line). The timers must be on for drops to apply; the interval never logs. Exits itself.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GPU_EVENT_TIMERS=1000000
CS_PASS_SKIP=ISReflectionBlurHCS Dispatch+ISReflectionBlurVCS Dispatch|Terrain Blending - Render Passes|ISVolumetricLightingBlurHCS Dispatch+ISVolumetricLightingBlurVCS Dispatch|Water Effects|Shadowmasks|Depth
CS_PASS_ROUNDS=4
CS_DCLF_TEST_COMMANDS=30:tgm

# The late poses (Api/LatePoses.h) without Improved Camera: the newest save in first person, the player's skins marked posed again at the
# depth commit with their bones unchanged (CS_DCLF_LATE_POSE=rewind). The frame values line counts the late producers and skins; the
# shots must match a run with CS_DCLF_LATE_POSE=0. The GPU-driven graph, then the CPU pipeline.
CS_DCLF_LATE_POSE=rewind
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=600:dclf:shot=lp-rewind-gpu;1100:dclf:pipeline=cpu;1500:dclf:shot=lp-rewind-cpu;1600:dclf:pipeline=auto
CS_DCLF_TEST_EXIT=1900

# NvPerf per pass at the newest save: DCLF's graph passes beside the engine's events holding the same work, vertex and pixel work apart. Keep the game focused.
CS_NVPERF_RANGES=Depth,World,Directional Light Shadowmaps,First Person View,cs.dclf.*,cs.llf.*
CS_NVPERF_METRICS=gpu__time_duration:counter,smsp__inst_executed_shader_vs:counter,smsp__inst_executed_shader_ps:counter,smsp__inst_executed_shader_cs:counter,sm__warps_launched_shader_vs:counter,sm__warps_launched_shader_ps:counter,sm__threads_launched_shader_vs:counter,sm__threads_launched_shader_ps:counter,smsp__inst_executed_pipe_tex:counter,smsp__inst_executed_pipe_lsu:counter,pda__input_prims:counter,pda__input_verts:counter,fe__draw_count:counter,raster__zcull_input_samples:counter,raster__zcull_output_samples:counter,prop__prop2crop_pixels_realtime:counter,dram__bytes_read:counter,dram__bytes_write:counter
CS_NVPERF_START_FRAME=1800
CS_NVPERF_SAMPLES=4
CS_DCLF_TEST_EXIT=2800

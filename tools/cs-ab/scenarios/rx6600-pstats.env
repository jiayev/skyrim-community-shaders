# RX 6600 timing at the newest save (Start On Save loads it): 3,000 frames to settle (DCLF's pipelines compile in the first
# frames), then 1,000 measured, with GPU event timer blocks every 250 frames. DXVK takes the RX 6600, not the integrated GPU;
# native D3D11 takes the default adapter (check its log). Hang markers stay on for every RX 6600 run (the -nomarkers twin drops
# them, only to measure their cost).
# tgm first: a wolf attacks the player at the newest save, and god mode keeps every run's scene alike.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GPU_EVENT_TIMERS=250
CS_DCLF_TEST_COMMANDS=30:tgm
CS_DCLF_TEST_EXIT=1500
DXVK_PIPELINE_STATS=1

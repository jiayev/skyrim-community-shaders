# NvPerf per engine shader at the newest save: which shaders cost more than on dev, and what the water cubemap draws. Keep the game focused.
CS_NVPERF_RANGES=[*
CS_NVPERF_METRICS=gpu__time_duration:counter,smsp__inst_executed:counter,smsp__inst_executed_shader_ps:counter,smsp__inst_executed_pipe_tex:counter,smsp__inst_executed_pipe_lsu:counter,sm__warps_launched_shader_ps:counter,prop__prop2sm_pixels_mode_earlyz:counter,prop__prop2sm_pixels_mode_latez:counter,raster__zcull_input_samples:counter,raster__zcull_output_samples:counter,prop__prop2zrop_pixels_mode_earlyz_op_killed_realtime:counter,prop__prop2zrop_pixels_mode_latez_op_killed_realtime:counter,prop__prop2crop_pixels_realtime:counter,dram__throughput:throughput,lts__throughput:throughput
CS_NVPERF_START_FRAME=1600
CS_NVPERF_SAMPLES=4
CS_DCLF_TEST_EXIT=2300

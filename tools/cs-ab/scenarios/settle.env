# Each stop dumps twice: a dump writes the snapshot before it, so the later one is that stop's.
# Holds a low-memory stop for 5,000 frames and a high one for 2,000: where DXVK's chunk free space ends up with the timing gone.
CS_DCLF_TEST_COMMANDS=900:dclf:mark=save;901:dclf:vram-json;931:dclf:vram-json;960:coc Whiterun;2400:dclf:mark=whiterun;2401:dclf:vram-json;2431:dclf:vram-json;2460:coc Riverwood;3900:dclf:mark=riverwood;3901:dclf:vram-json;3931:dclf:vram-json;3960:coc SolitudeOrigin;5460:dclf:mark=solitude-early;5461:dclf:vram-json;5491:dclf:vram-json;8900:dclf:mark=solitude;8901:dclf:vram-json;8931:dclf:vram-json;8960:coc Whiterun;10460:dclf:mark=whiterun2-early;10461:dclf:vram-json;10491:dclf:vram-json;10900:dclf:mark=whiterun2;10901:dclf:vram-json;10931:dclf:vram-json
CS_DCLF_TEST_EXIT=10960

# RX 6600: the same view GPU-driven and CPU-driven (two shots each, a frame apart, to tell motion from difference), then with the
# wave probe (dclf:define=DCLF_WAVE_PROBE: magenta where a pulled Lighting pixel wave holds several draws) on both pipelines.
# Shots go to <log directory>/dclf-shots. tgm first: a wolf attacks the player at the newest save.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=30:tgm;1500:dclf:shot=rx-gpu-a;1502:dclf:shot=rx-gpu-b;1510:dclf:pipeline=cpu;1520:dclf:wait=settled;1700:dclf:shot=rx-cpu-a;1702:dclf:shot=rx-cpu-b;1710:dclf:pipeline=gpu;1720:dclf:wait=settled;1900:dclf:define=DCLF_WAVE_PROBE;1905:dclf:reload-shaders=Lighting.hlsl;1910:dclf:wait=reload;2100:dclf:shot=rx-probe-gpu;2110:dclf:pipeline=cpu;2120:dclf:wait=settled;2300:dclf:shot=rx-probe-cpu;2400:qqq

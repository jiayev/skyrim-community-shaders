# As rx6600-perf-whiterun.env without hang markers: only to measure what the markers cost.
# RX 6600 timing in Whiterun (coc Whiterun from the newest save: the heavier CPU scene): 3,000 frames to settle (DCLF's
# pipelines compile in the first frames), then 1,000 measured, with GPU event timer blocks every 250 frames. DXVK takes the RX
# 6600, not the integrated GPU; native D3D11 takes the default adapter (check its log). Hang markers stay on for every RX 6600
# run (the -nomarkers twin drops them, only to measure their cost).
# tgm first: a wolf attacks the player at the newest save, and god mode keeps every run's scene alike.
DXVK_FILTER_DEVICE_NAME=AMD Radeon RX 6600
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GPU_EVENT_TIMERS=250
CS_DCLF_TEST_COMMANDS=30:tgm;300:coc Whiterun;3000:dclf:mark=start;4000:dclf:mark=end
CS_DCLF_TEST_EXIT=4010
